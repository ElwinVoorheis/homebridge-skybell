# Copy to .env and fill in. Never commit .env.
# SkyBell app login
SKYBELL_USERNAME=
SKYBELL_PASSWORD=
# Shared between server and MediaMTX; at least 16 random characters (e.g. `openssl rand -hex 24`)
INTERNAL_SECRET=
# Host name or IP that Frigate and browsers use to reach this machine
RTSP_PUBLIC_HOST=
# Optional (defaults shown)
# RTSP_PUBLIC_PORT=8554
# PUBLIC_PORT=3000
# INTERNAL_PORT=3001
# MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
# LOG_LEVEL=info
